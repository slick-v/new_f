# Groq
GROQ_API_KEY=your_groq_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Postgres (used by docker-compose)
POSTGRES_USER=chat
POSTGRES_PASSWORD=change_me
POSTGRES_DB=chatdb

# App connection string (must match the values above)
DATABASE_URL=postgresql+asyncpg://chat:change_me@localhost:5432/chatdb

# Comma-separated demo keys; empty = no auth (local dev only)
DEMO_API_KEYS=